{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.development)",
      "Write(./.env.production)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(type .env)",
      "Bash(mv .env*)",
      "Bash(cp .env*)",
      "Bash(rm .env*)",
      "Bash(Get-Content .env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\"",
            "timeout": 10,
            "statusMessage": "Vérification des règles projet…"
          }
        ]
      }
    ]
  }
}
