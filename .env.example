# --- Base de données (Neon) ---
# URL "pooled" utilisée par l'application (Neon : hôte avec le suffixe -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
# URL directe (sans -pooler) utilisée par Prisma Migrate et par le script d'import
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# --- Better Auth ---
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique de l'app (http://localhost:3000 en dev)
BETTER_AUTH_URL="http://localhost:3000"

# --- Cache ---
# Jeton exigé par POST /api/revalidate en production (vide = appel libre, en dev seulement)
# Générer avec : openssl rand -base64 32
REVALIDATE_SECRET=""
